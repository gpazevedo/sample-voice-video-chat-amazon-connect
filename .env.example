# ============================================================================
# AWS CONFIGURATION
# ============================================================================
# AWS Account ID (12-digit number)
# Get this from AWS Console or run: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# ============================================================================
# AMAZON CONNECT CONFIGURATION
# ============================================================================
# Amazon Connect Instance Configuration
AMAZON_CONNECT_INSTANCE_ID=your-instance-id-here
AMAZON_CONNECT_INSTANCE_ALIAS=your-instance-alias-here
AMAZON_CONNECT_QUEUE_ID=your-queue-id-here

# Contact Flow IDs (Auto-generated from CDK deployment)
AMAZON_CONNECT_WEBRTC_FLOW_ID=PLACEHOLDER_WEBRTC_FLOW_ID
AMAZON_CONNECT_CHAT_FLOW_ID=PLACEHOLDER_CHAT_FLOW_ID

# Amazon Connect Chat Widget Configuration (Auto-extracted from widget script)
# Run: npm run extract-chat-ids
AMAZON_CONNECT_CHAT_SNIPPET_ID=PLACEHOLDER_CHAT_SNIPPET_ID
AMAZON_CONNECT_CHAT_DOCUMENT_ID=PLACEHOLDER_CHAT_DOCUMENT_ID

# ============================================================================
# COGNITO CONFIGURATION (Auto-generated from CDK deployment)
# ============================================================================
# Cognito User Pool ID
COGNITO_USER_POOL_ID=PLACEHOLDER_USER_POOL_ID

# Cognito User Pool Client ID
COGNITO_CLIENT_ID=PLACEHOLDER_CLIENT_ID

# Cognito Identity Pool ID
COGNITO_IDENTITY_POOL_ID=PLACEHOLDER_IDENTITY_POOL_ID

# ============================================================================
# APPLICATION CONFIGURATION (Keep as it is)
# ============================================================================
# Feature Flags
AMAZON_CONNECT_ENABLE_VIDEO=true
AMAZON_CONNECT_ENABLE_CHAT=true

# ============================================================================
# LOCAL DEVELOPMENT SERVER CONFIGURATION (Keep as it is)
# ============================================================================
# Port for local development server (optional, defaults to 8080)
# Used when running: npm run serve
# Access the application at: http://localhost:8080
# Note: This is only for local testing. Production uses CloudFront distribution.
PORT=8080
