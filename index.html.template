<body>
  <!-- App container - will be used by LoginComponent and main app -->
  <div id="app-container">
    <div class="loading">
      <span class="spinner"></span>
      <span>Loading application...</span>
    </div>
  </div>

  <!-- Audio element for WebRTC -->
  <audio id="audio-element" autoplay controls style="display: none;"></audio>

  <!-- Load the application bundle -->
  <script src="amazon-connect-web-app.js"></script>
  
  <script>
    // Initialize the application with Cognito authentication
    (async function() {
      try {
        // Fetch configuration from server
        const response = await fetch('/config.json');
        if (!response.ok) {
          throw new Error(`Failed to load configuration: HTTP ${response.status}`);
        }
        
        const config = await response.json();
        
        if (config.error) {
          throw new Error(config.error);
        }

        // Verify we're in Cognito authenticated mode
        if (config.credentialMode !== 'cognito-authenticated') {
          throw new Error('This page requires Cognito authenticated mode. Please set CREDENTIAL_MODE=cognito-authenticated in your .env file.');
        }

        // Store participant name globally (will be set after authentication)
        let participantName = 'Customer'; // Default

        // Create app configuration
        const appConfig = {
          region: config.region,
          instanceId: config.instanceId,
          contactFlowId: config.contactFlowId,
          chatContactFlowId: config.chatContactFlowId,
          credentialMode: config.credentialMode,
          cognitoUserPoolId: config.cognitoUserPoolId,
          cognitoClientId: config.cognitoClientId,
          cognitoIdentityPoolId: config.cognitoIdentityPoolId,
          participantDisplayName: participantName, // Will be updated after login
          containerId: 'app-container',
          enableVideo: config.enableVideo !== false,
          enableChat: config.enableChat !== false,
          enableFileSharing: config.enableFileSharing !== false,
          maxFileSize: config.maxFileSize || 10485760
        };

        console.log('[App] Initializing with Cognito authentication...');
        
        // Create and initialize the app
        // The app will automatically show the login screen
        const app = new AmazonConnectWebApp.AmazonConnectApp(appConfig);
        await app.initialize();
        
        console.log('[App] Application initialized successfully');
        
        // Get the participant name from the app (updated after authentication)
        participantName = app.getParticipantDisplayName();
        console.log('[App] Participant name:', participantName);
        
        // After successful initialization, show the main UI
        showMainUI(app, participantName);
        
      } catch (error) {
        console.error('[App] Initialization failed:', error);
        
        // Display error to user
        const container = document.getElementById('app-container');
        container.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: center; height: 100vh; padding: 20px;">
            <div style="background: white; padding: 40px; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 500px;">
              <h2 style="color: #ef4444; margin-bottom: 20px;">⚠️ Initialization Failed</h2>
              <p style="color: #374151; margin-bottom: 15px; line-height: 1.6;">${error.message}</p>
              <button onclick="location.reload()" style="background: #667eea; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;">
                Retry
              </button>
            </div>
          </div>
        `;
      }
    })();

    // Show main UI after successful authentication and initialization
    function showMainUI(app, participantName) {
      console.log('[showMainUI] Rendering main UI...');
      const container = document.getElementById('app-container');
      console.log('[showMainUI] Container element:', container);
      
      if (!container) {
        console.error('[showMainUI] ERROR: app-container element not found!');
        return;
      }
      
      // Clear any existing content (including login component)
      container.innerHTML = '';
      
      // Make container visible (LoginComponent.hide() sets display: none)
      container.style.display = 'block';
      console.log('[showMainUI] Container made visible, now rendering main UI...');
      
      // Track chat widget state
      let chatWidgetInitialized = false;
      let chatWidgetScriptElement = null; // Track the chat widget script element
      let isCallInitiating = false; // Track if a call is currently being initiated
      let callStartTime = null;
      let durationInterval = null;
      
      function startDurationTimer() {
        callStartTime = Date.now();
        if (durationInterval) clearInterval(durationInterval);
        durationInterval = setInterval(() => {
          if (callStartTime) {
            const elapsed = Math.floor((Date.now() - callStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60);
            const seconds = elapsed % 60;
            statusDuration.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
          }
        }, 1000);
      }

      function stopDurationTimer() {
        if (durationInterval) {
          clearInterval(durationInterval);
          durationInterval = null;
        }
        callStartTime = null;
        statusDuration.textContent = '00:00';
      }
      
      // Function to show chat widget tooltip
      function showChatWidgetTooltip() {
        // Create tooltip element
        const tooltip = document.createElement('div');
        tooltip.className = 'chat-widget-tooltip';
        tooltip.innerHTML = '💬 Click the chat icon to start a conversation with an agent';
        document.body.appendChild(tooltip);
        
        // Remove tooltip after animation completes (5 seconds)
        setTimeout(() => {
          tooltip.remove();
        }, 5000);
      }
      
      // Function to completely remove chat widget
      function removeChatWidget() {
        console.log('[removeChatWidget] Removing Amazon Connect Chat Widget...');
        
        // Get config for chat widget document ID
        fetch('/config.json').then(res => res.json()).then(config => {
          // Remove the chat widget iframe and container
          const chatContainer = document.getElementById(config.chatDocumentId);
          if (chatContainer) {
            chatContainer.remove();
            console.log('[removeChatWidget] Removed chat container');
          }
          
          // Remove any chat widget elements (the widget creates multiple elements)
          const chatElements = document.querySelectorAll('[id^="amazon-connect-chat"]');
          chatElements.forEach(el => {
            el.remove();
            console.log('[removeChatWidget] Removed chat element:', el.id);
          });
          
          // Remove the script element
          if (chatWidgetScriptElement) {
            chatWidgetScriptElement.remove();
            chatWidgetScriptElement = null;
            console.log('[removeChatWidget] Removed chat widget script');
          }
          
          // Clear the amazon_connect global function
          if (window.amazon_connect) {
            delete window.amazon_connect;
            console.log('[removeChatWidget] Cleared amazon_connect global');
          }
          
          console.log('[removeChatWidget] Chat widget completely removed');
        });
      }
      
      container.innerHTML = `
        <div class="main-ui">
          <div class="main-header">
            <div class="header-content">
              <img src="AmazonConnectLogo.png" alt="Amazon Connect" class="header-logo">
              <div class="header-text">
                <h1><span class="phone-icon">📞</span> <span class="chat-icon">💬</span> Amazon Connect</h1>
                <p>Authenticated and ready to connect</p>
              </div>
            </div>
          </div>

          <div class="main-content">
            <div class="info-box">
              <p>✅ Successfully authenticated with Cognito. You can now start a WebRTC call or chat session.</p>
            </div>

            <div class="button-group">
              <button id="start-call-btn" class="btn-success">📞 Start Voice Call</button>
              <button id="start-video-call-btn" class="btn-success">📹 Start Video Call</button>
              <button id="start-chat-btn" class="btn-primary" disabled>💬 Start Chat with the Same Agent</button>
              <button id="end-call-btn" class="btn-danger" disabled>End Call</button>
            </div>

            <div class="status-section">
              <div class="status-label">Call Duration</div>
              <div id="status-duration" class="status-value">00:00</div>
            </div>

            <div id="video-container">
              <div class="video-grid">
                <div class="video-wrapper">
                  <div class="video-label">Your Video</div>
                  <video id="local-video" autoplay muted playsinline></video>
                </div>
                <div class="video-wrapper">
                  <div class="video-label">Agent Video</div>
                  <video id="remote-video" autoplay playsinline></video>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;

      // Set up event listeners
      const startCallBtn = document.getElementById('start-call-btn');
      const startVideoCallBtn = document.getElementById('start-video-call-btn');
      const startChatBtn = document.getElementById('start-chat-btn');
      const endCallBtn = document.getElementById('end-call-btn');
      const statusDuration = document.getElementById('status-duration');
      const videoContainer = document.getElementById('video-container');

      startCallBtn.addEventListener('click', async () => {
        try {
          // Prevent multiple simultaneous call initiations
          if (isCallInitiating) {
            console.log('[startCallBtn] Call already being initiated, ignoring click');
            return;
          }
          
          isCallInitiating = true;
          startCallBtn.disabled = true;
          startVideoCallBtn.disabled = true;
          
          await app.startCall({ enableVideo: false });
          startDurationTimer();
          endCallBtn.disabled = false;
          
          isCallInitiating = false;
          
          // Enable chat button once call is active
          startChatBtn.disabled = false;
        } catch (error) {
          isCallInitiating = false;
          startCallBtn.disabled = false;
          startVideoCallBtn.disabled = false;
          alert('Failed to start call: ' + error.message);
          console.error(error);
        }
      });

      startVideoCallBtn.addEventListener('click', async () => {
        try {
          // Prevent multiple simultaneous call initiations
          if (isCallInitiating) {
            console.log('[startVideoCallBtn] Call already being initiated, ignoring click');
            return;
          }
          
          isCallInitiating = true;
          startCallBtn.disabled = true;
          startVideoCallBtn.disabled = true;
          
          videoContainer.classList.add('active');
          await app.startCall({ enableVideo: true });
          startDurationTimer();
          endCallBtn.disabled = false;
          
          isCallInitiating = false;
          
          // Enable chat button once call is active
          startChatBtn.disabled = false;
        } catch (error) {
          videoContainer.classList.remove('active');
          isCallInitiating = false;
          startCallBtn.disabled = false;
          startVideoCallBtn.disabled = false;
          alert('Failed to start video call: ' + error.message);
          console.error(error);
        }
      });

      startChatBtn.addEventListener('click', async () => {
        try {
          const agentId = app.getAgentId ? app.getAgentId() : null;
          console.log('[startChatBtn] Attempting to start chat with agent ID:', agentId);
          
          if (!agentId) {
            console.warn('[startChatBtn] No agent ID available yet');
            alert('Please wait for the agent to answer the call.');
            return;
          }

          // Get config for chat widget
          const response = await fetch('/config.json');
          const config = await response.json();

          if (!config.chatSnippetId) {
            console.error('[startChatBtn] Chat snippet ID not configured');
            alert('Chat is not configured. Please contact support.');
            return;
          }

          if (!config.chatDocumentId) {
            console.error('[startChatBtn] Chat document ID not configured');
            alert('Chat document ID is not configured. Please contact support.');
            return;
          }

          console.log('[startChatBtn] Initializing Amazon Connect Chat Widget...');
          console.log('[startChatBtn] Instance Alias:', config.instanceAlias);
          console.log('[startChatBtn] Chat Snippet ID:', config.chatSnippetId.substring(0, 20) + '...');
          console.log('[startChatBtn] Chat Document ID:', config.chatDocumentId);
          console.log('[startChatBtn] Agent ID:', agentId);

          // Load Amazon Connect Chat Widget
          (function (w, d, x, id) {
            s = d.createElement('script');
            s.src = `https://${config.instanceAlias}.my.connect.aws/connectwidget/static/amazon-connect-chat-interface-client.js`;
            s.async = 1;
            s.id = id;
            d.getElementsByTagName('head')[0].appendChild(s);
            w[x] = w[x] || function () { (w[x].ac = w[x].ac || []).push(arguments) };
            chatWidgetScriptElement = s; // Store reference to script element
            console.log('[startChatBtn] Chat widget script loaded from:', s.src);
          })(window, document, 'amazon_connect', config.chatDocumentId);
          
          // Configure chat widget
          amazon_connect('styles', { 
            iconType: 'CHAT', 
            openChat: { color: '#ffffff', backgroundColor: '#dc2626' }, 
            closeChat: { color: '#ffffff', backgroundColor: '#dc2626' } 
          });
          amazon_connect('snippetId', config.chatSnippetId);
          amazon_connect('customStyles', { 
            global: { frameWidth: '400px', frameHeight: '600px' } 
          });
          amazon_connect('supportedMessagingContentTypes', [
            'text/plain', 
            'text/markdown', 
            'application/vnd.amazonaws.connect.message.interactive', 
            'application/vnd.amazonaws.connect.message.interactive.response'
          ]);
          
          // Set customer display name from authenticated user
          amazon_connect('customerDisplayName', function(callback) { 
            callback(participantName); 
          });
          
          // Pass agent ID as contact attribute for routing
          amazon_connect('contactAttributes', { AgentId: agentId });

          startChatBtn.disabled = true;
          chatWidgetInitialized = true;
          
          console.log('[startChatBtn] ✅ Chat widget initialized successfully');
          
          // Show helpful tooltip to inform user about the chat widget
          showChatWidgetTooltip();
        } catch (error) {
          alert('Failed to start chat: ' + error.message);
          console.error(error);
        }
      });

      endCallBtn.addEventListener('click', async () => {
        try {
          console.log('[endCallBtn] Ending call...');
          
          stopDurationTimer();
          videoContainer.classList.remove('active');
          
          // Reset agent ID to disable chat button
          const webrtcManager = app.getWebRTCManager();
          if (webrtcManager) {
            console.log('[endCallBtn] Resetting agent ID to null');
            webrtcManager.setAgentId(null);
          }
          
          // Remove chat widget completely if it was initialized
          if (chatWidgetInitialized) {
            removeChatWidget();
          }
          
          // Reset chat widget flag so it can be reinitialized with new agent
          chatWidgetInitialized = false;
          
          await app.endCall();
          startCallBtn.disabled = false;
          startVideoCallBtn.disabled = false;
          startChatBtn.disabled = true;
          endCallBtn.disabled = true;
        } catch (error) {
          alert('Failed to end call: ' + error.message);
          console.error(error);
        }
      });

      // Set up call ended callback
      const webrtcManager = app.getWebRTCManager();
      if (webrtcManager) {
        webrtcManager.onCallEnded(() => {
          console.log('[onCallEnded] WebRTC call ended - cleaning up');
          
          stopDurationTimer();
          videoContainer.classList.remove('active');
          
          // Reset agent ID to disable chat button
          console.log('[onCallEnded] Resetting agent ID to null');
          webrtcManager.setAgentId(null);
          
          // Remove chat widget completely if it was initialized
          if (chatWidgetInitialized) {
            removeChatWidget();
          }
          
          // Reset chat widget flag so it can be reinitialized with new agent
          chatWidgetInitialized = false;
          
          startCallBtn.disabled = false;
          startVideoCallBtn.disabled = false;
          startChatBtn.disabled = true;
          endCallBtn.disabled = true;
        });
      }
    }
  </script>
</body>
</html>
