<head>
  <script>
    // Embedded configuration (generated at build time for production)
    // This acts as a fallback when config.json is not available
    window.__EMBEDDED_CONFIG__ = {}; // placeholder — replaced by scripts/embed-config.js via npm run build:production
    
    // Smart fetch override: Try to fetch config.json first, fall back to embedded config
    (function() {
      const originalFetch = window.fetch;
      window.fetch = function(url, options) {
        const urlStr = typeof url === 'string' ? url : url.url || url.href;
        
        // Check if this is a config.json request
        if (urlStr && (
          urlStr === '/config.json' || 
          urlStr === 'config.json' ||
          urlStr.endsWith('/config.json') ||
          urlStr.includes('config.json')
        )) {
          // Try to fetch config.json first (for local development)
          return originalFetch.call(window, url, options)
            .then(async response => {
              if (response.ok) {
                // Check if response is actually JSON (not HTML error page)
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                  console.log('[Config] Using config.json from server (local development)');
                  return response;
                }
                // If content-type is not JSON, it's likely an HTML error page
                console.log('[Config] Received HTML instead of JSON, using embedded configuration');
              }
              // If fetch fails (404 in production) or returns HTML, use embedded config
              console.log('[Config] Using embedded configuration (production)');
              return Promise.resolve({
                ok: true,
                status: 200,
                statusText: 'OK',
                headers: new Headers({
                  'Content-Type': 'application/json'
                }),
                json: () => Promise.resolve(window.__EMBEDDED_CONFIG__),
                text: () => Promise.resolve(JSON.stringify(window.__EMBEDDED_CONFIG__)),
                clone: function() { return this; }
              });
            })
            .catch(error => {
              // Network error or CORS issue, use embedded config
              console.log('[Config] Using embedded configuration (fallback)');
              return Promise.resolve({
                ok: true,
                status: 200,
                statusText: 'OK',
                headers: new Headers({
                  'Content-Type': 'application/json'
                }),
                json: () => Promise.resolve(window.__EMBEDDED_CONFIG__),
                text: () => Promise.resolve(JSON.stringify(window.__EMBEDDED_CONFIG__)),
                clone: function() { return this; }
              });
            });
        }
        
        return originalFetch.call(window, url, options);
      };
    })();
  </script>

